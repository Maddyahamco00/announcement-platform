{
  "name": "announcement-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@announcement-platform/web",
    "dev:api": "npm run dev --workspace=@announcement-platform/api",
    "build:web": "npm run build --workspace=@announcement-platform/web",
    "build:api": "npm run build --workspace=@announcement-platform/api",
    "build": "npm run build:web && npm run build:api",
    "typecheck": "npm run build:web && npm run build:api"
  }
}
